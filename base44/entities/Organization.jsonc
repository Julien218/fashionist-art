{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'organisation"
    },
    "owner_user_id": {
      "type": "string",
      "description": "ID du user propri\u00e9taire"
    },
    "stripe_connected_account_id": {
      "type": "string",
      "description": "ID compte Stripe Connect"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "PENDING",
        "COMPLETE",
        "RESTRICTED"
      ],
      "default": "NOT_STARTED",
      "description": "Statut onboarding Stripe"
    },
    "charges_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Paiements activ\u00e9s"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Virements activ\u00e9s"
    }
  },
  "required": [
    "name",
    "owner_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}