{
  "name": "NewsletterSendLog",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "subscriber_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SENT",
        "FAILED",
        "BOUNCED"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "subscriber_email",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}