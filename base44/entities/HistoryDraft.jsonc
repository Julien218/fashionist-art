{
  "name": "HistoryDraft",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content_html": {
      "type": "string"
    },
    "content_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_VALIDATION",
        "APPROVED",
        "REJECTED",
        "PUBLISHED"
      ],
      "default": "DRAFT"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "organizer_email": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "validation_token": {
      "type": "string"
    },
    "validation_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "organizer_decision_note": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "content_html"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}