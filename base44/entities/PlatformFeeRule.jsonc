{
  "name": "PlatformFeeRule",
  "type": "object",
  "properties": {
    "sale_type": {
      "type": "string",
      "enum": [
        "bar",
        "stand",
        "sponsor",
        "artist_contact",
        "artist_sale",
        "other"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ]
    },
    "value": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "sale_type",
    "mode",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}